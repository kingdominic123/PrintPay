# OPTIONAL. The site builds and works without this file.
#
# Public Formspree form ID, i.e. the last part of your form endpoint:
#   https://formspree.io/f/xyzabcde   ->   xyzabcde
#
# - Set it   : the contact form POSTs to Formspree and shows "sent" ONLY if Formspree accepts it.
# - Leave it blank/unset : the form opens the visitor's email app, pre-filled, and says clearly
#   that nothing has been sent yet.
#
# This value is public (it ends up in the browser bundle). NEVER put a secret key here.
# It is read at BUILD time: after changing it, rebuild/redeploy.
VITE_FORMSPREE_FORM_ID=xrbkynab
